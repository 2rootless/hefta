{
  "name": "hefta",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.vermieter.config.ts && node scripts/check-dist.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:kurz": "playwright test --grep-invert \"alle Bildschirme in Ansicht\"",
    "test:katalog": "playwright test tests/e2e/pruefkatalog.spec.ts --project chromium",
    "test:backups": "node scripts/test-backups.mjs",
    "muster-mappen": "node scripts/muster-mappen.mjs",
    "wortliste": "vitest run build/wortliste.test.ts --mode schreiben",
    "verify": "npm run check && npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "@fontsource-variable/archivo": "5.3.0",
    "idb": "8.0.4",
    "pdfjs-dist": "6.4.299",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
